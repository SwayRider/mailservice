########################################
# Service ports and urls               #
########################################
#
# Most of these can be kept as is.
# You probably only need to change these ports if you run multiple
# services simultaneously on your local dev machine.
#

HTTP_PORT=8082

GRPC_PORT=8083

########################################
# Authservice connection             #
########################################
#
# Connection details to the authservice
# Adjust these if authservice runs on a different host/port
#

AUTHSERVICE_HOST=authservice.example.com
AUTHSERVICE_PORT=8081

########################################
# Mail templates                    #
########################################
#
# Directory containing mail templates
#

MAIL_TEMPLATES_DIR=assets/templates

########################################
# SMTP configuration               #
########################################
#
# SMTP server configuration for sending emails
# Update these to match your SMTP provider settings
#

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=swayrider@example.com
SMTP_PASSWORD=MyMailPassword123

########################################
# Sender domain allowlist          #
########################################
#
# Comma-separated list of domains allowed in the request "From" address.
# If unset, defaults to the domain of SMTP_USER (e.g. "example.com" above).
#

MAIL_ALLOWED_FROM_DOMAINS=

########################################
# Rate limiting                        #
########################################
#
# Coarse per-source-IP rate limit applied to both the gRPC port and the
# HTTP/REST gateway. A safety net in case the service is ever reached
# directly by more callers than expected.
#

RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
RATE_LIMIT_IDLE_TTL_SECS=300
