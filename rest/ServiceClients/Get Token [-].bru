meta {
  name: Get Token [*]
  type: http
  seq: 1
}

post {
  url: {{AUTHSERVICE_HOST}}:{{AUTHSERVICE_PORT}}/api/v1/auth/token
  body: json
  auth: inherit
}

body:json {
  {
    "clientId": "{{MAIL_SEND_SERVICE_CLIENT_ID}}",
    "clientSecret": "{{MAIL_SEND_SERVICE_CLIENT_SECRET}}",
    "scopes": ["*"]
  }
}
