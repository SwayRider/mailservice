meta {
  name: Send [S]
  type: http
  seq: 4
}

post {
  url: {{MAILSERVICE_HOST}}:{{MAILSERVICE_PORT}}/api/v1/mail/send
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "from": "swayrider@hevanto-it.com",
    "to": ["maarten.heremans@gmail.com"],
    "subject": "Test mail from SwayRider",
    "textBody": "Dit is een test mail"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
